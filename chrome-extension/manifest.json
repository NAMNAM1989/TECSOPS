{
  "manifest_version": 3,
  "name": "TECSOPS — Kho TECS-TCS ESID",
  "version": "2.6.0",
  "description": "Điền ESID TCS / tải PDF cho kho TECS-TCS (tài khoản độc lập). OCR CAPTCHA offline trong Ext.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "downloads",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.tcs.com.vn/*",
    "https://tcs.com.vn/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://ops-production-b405.up.railway.app/*",
    "https://*.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TECSOPS · Kho TECS-TCS ESID",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*",
        "https://ops-production-b405.up.railway.app/*",
        "https://*.up.railway.app/*"
      ],
      "js": [
        "content-ops.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tcs.com.vn/*",
        "https://tcs.com.vn/*"
      ],
      "js": [
        "content-tcs.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "locators.json",
        "print-frame.html",
        "ocr/*"
      ],
      "matches": [
        "https://www.tcs.com.vn/*",
        "https://tcs.com.vn/*",
        "<all_urls>"
      ]
    }
  ]
}
