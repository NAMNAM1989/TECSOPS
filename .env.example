# Bản sao môi trường — không đưa giá trị thật vào git. Railway: Service → Variables.

# Cổng HTTP (Railway tự inject; local có thể bỏ trống → mặc định 3001 trong code)
# PORT=3001

# production | development (build Vite thường set production)
# NODE_ENV=production

# Postgres — BẮT BUỘC. Nguồn dữ liệu chính (bảng app_state, cột state jsonb).
# Local: docker compose up -d  →  port 5434
# DATABASE_URL=postgresql://tecsops:tecsops@127.0.0.1:5434/tecsops
# POSTGRES_STATE_KEY=tecsops:state

# eCargo OTP — Gmail App Password (mail chung đăng ký VCT). Không commit mật khẩu thật.
# Checklist:
# 1) Gmail bật 2FA → Google Account → Security → App passwords → tạo mật khẩu 16 ký tự
# 2) Dán vào ECARGO_IMAP_PASS (không dùng mật khẩu đăng nhập Gmail thường)
# 3) ECARGO_IMAP_USER = đúng hộp thư nhận OTP eCargo
# 4) Hồ sơ đại lý trong Ops (Email OTP) phải trùng mailbox này
# 5) Railway: Service → Variables → thêm 5 biến dưới → Redeploy/restart
# 6) Local: copy vào .env hoặc .env.local rồi restart `npm run dev`
# 7) Kiểm tra: GET /api/ecargo/otp/status → imapConfigured:true ; hoặc nút «Kiểm tra mail OTP» trong modal
# ECARGO_IMAP_HOST=imap.gmail.com
# ECARGO_IMAP_PORT=993
# ECARGO_IMAP_USER=ops-ecargo@example.com
# ECARGO_IMAP_PASS=xxxx-xxxx-xxxx-xxxx
# ECARGO_IMAP_MAILBOX=INBOX

# Google Sheet BOOK HẰNG NGÀY — nhập lô từ tab DDMONTHYYYY (vd. 13JUNE2026)
# GOOGLE_SHEETS_BOOK_SPREADSHEET_ID=15EHqZuuYznL2_VkCnpENHgc_mmBTSJGgrNG3iv5ZvA4

# Dev: cổng API khi proxy Vite (mặc định 3001, trùng server)
# VITE_PROXY_PORT=3001

# CORS Socket.IO: danh sách origin được phép, cách nhau bởi dấu phẩy.
# Production: nếu để trống → chỉ same-origin. Dev (Vite proxy) thường không cần set.
# CORS_ORIGINS=https://your-app.up.railway.app

# Sau khi `npm run deploy:ship` push xong, script poll GET …/api/health.
# TECSOPS_VERIFY_URL=https://your-app.up.railway.app
# TECSOPS_VERIFY_WAIT_MS=900000
# TECSOPS_VERIFY_INTERVAL_MS=10000

# Gemini — AI chính (báo cáo đề xuất nâng cấp Ops). Chỉ server; KHÔNG commit key.
# Lấy key: https://aistudio.google.com/apikey → dán vào .env.local / Railway Variables
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Railway CLI — PROJECT TOKEN (đặt trong .env.local, KHÔNG commit).
# Railway Dashboard → project → Project Settings → Tokens → Create
# RAILWAY_TOKEN=

# Khi git push báo "Everything up-to-date": Deploy Hook hoặc empty commit redeploy.
# RAILWAY_DEPLOY_HOOK_URL=https://api.railway.app/...
# TECSOPS_NO_EMPTY_REDEPLOY=1

# Portal remote (phone 4G → Railway → worker PC) — cả TECS-TCS và TCS
# Railway Variables:
#   PORTAL_WORKER_SECRET=đổi-chuỗi-dài-bí-mật
#
# Cần 2 agent + 2 worker (2 tài khoản portal khác nhau), ví dụ cùng 1 PC:
#   Agent hub  :8765  + worker PORTAL_WAREHOUSE=TECS-TCS
#   Agent TCS  :8766  + worker PORTAL_WAREHOUSE=TCS
# Máy kho (worker) — đóng Chrome sau khi tải PDF xong (nhẹ máy):
#   PORTAL_CLOSE_AFTER_PDF=1
#   PORTAL_BROWSER_IDLE_MS=15000
#   (0 = đóng ngay; tăng nếu hay tải nhiều PDF liên tiếp)
#
# Policy chọn đường (mặc định auto = Ext → agent → remote; PDF: agent → Ext → remote):
#   VITE_PORTAL_EXECUTOR_POLICY=auto
# Dual agent local / Railway (start-fullstack):
#   TCS_AGENT_URL=http://127.0.0.1:8765
#   TCS_AGENT_URL_TCS=http://127.0.0.1:8766
#   TCS_AGENT_DUAL=1
#   TCS_USERNAME=hanam7195          # hub TECS-TCS (:8765) — BẮT BUỘC khác user kho TCS
#   TCS_PASSWORD=...
#   TCS_USERNAME_TCS=namnam8012     # kho TCS (:8766) — KHÔNG fallback sang TCS_USERNAME
#   TCS_PASSWORD_TCS=...
#   TCS_BROWSER_PROFILE_TCS=./browser_profile_tcs
# Phone trên Railway: probe /tcs-agent — có agent thì không dùng worker PC.
# Region khuyến nghị: asia-southeast1. Volume: browser_profile_hub + browser_profile_tcs.
